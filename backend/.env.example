# ---- Database ----
# For local pgAdmin: update user, password, port, and dbname to match your setup
# Default port is 5432 for local PostgreSQL, 5433 if you have multiple versions
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learnexa_db

# ---- Auth ----
SECRET_KEY=change-this-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS (optional) ----
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- Setup Instructions ----
# 1. Open pgAdmin and create a database called "learnexa_db"
# 2. Copy this file to .env and update DATABASE_URL with your postgres password
# 3. Run: python -m uvicorn app.main:app --reload --port 8000
# 4. Test accounts are auto-created on startup (admin@ssb.edu / admin123)
